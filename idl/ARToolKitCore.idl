interface ARToolKitCore {
  void ARToolKitCore();
   // ---- ARToolKit constants ----
   static long ERROR_OK_();
   static long ERROR_NOT_INITIALIZED_();
   static long ERROR_INVALID_ARGUMENT_();
   static long ERROR_ARCONTROLLER_NOT_FOUND_();
   static long ERROR_MARKER_INDEX_OUT_OF_BOUNDS_();

   static long AR_DEBUG_DISABLE_();
   static long AR_DEBUG_ENABLE_();

   static long AR_DEFAULT_LABELING_THRESH_();

   static long AR_IMAGE_PROC_FRAME_IMAGE_();
   static long AR_IMAGE_PROC_FIELD_IMAGE_();
   static long AR_DEFAULT_IMAGE_PROC_MODE_();

   static long AR_MAX_LOOP_COUNT_();
   static long AR_LOOP_BREAK_THRESH_();

   static long AR_LOG_LEVEL_DEBUG_();
   static long AR_LOG_LEVEL_INFO_();
   static long AR_LOG_LEVEL_WARN_();
   static long AR_LOG_LEVEL_ERROR_();
   static long AR_LOG_LEVEL_REL_INFO_();

   static long AR_LABELING_THRESH_MODE_MANUAL_();
   static long AR_LABELING_THRESH_MODE_AUTO_MEDIAN_();
   static long AR_LABELING_THRESH_MODE_AUTO_OTSU_();
   static long AR_LABELING_THRESH_MODE_AUTO_ADAPTIVE_();

   static long AR_MARKER_INFO_CUTOFF_PHASE_NONE_();
   static long AR_MARKER_INFO_CUTOFF_PHASE_PATTERN_EXTRACTION_();
   static long AR_MARKER_INFO_CUTOFF_PHASE_MATCH_GENERIC_();
   static long AR_MARKER_INFO_CUTOFF_PHASE_MATCH_CONTRAST_();
   static long AR_MARKER_INFO_CUTOFF_PHASE_MATCH_BARCODE_NOT_FOUND_();
   static long AR_MARKER_INFO_CUTOFF_PHASE_MATCH_BARCODE_EDC_FAIL_();
   static long AR_MARKER_INFO_CUTOFF_PHASE_MATCH_CONFIDENCE_();
   static long AR_MARKER_INFO_CUTOFF_PHASE_POSE_ERROR_();
   static long AR_MARKER_INFO_CUTOFF_PHASE_POSE_ERROR_MULTI_();
   static long AR_MARKER_INFO_CUTOFF_PHASE_HEURISTIC_TROUBLESOME_MATRIX_CODES_();

  // ---- lifecycle ----
  long setup(long width, long height, long cameraID);
  long teardown();

  // ---- camera ----
  long loadCameraFromPath(DOMString cparamPath);
  long loadCameraFromBuffer(long dataPtr, long dataLen); // TODO in C++: implement via MEMFS or memory loader
  void getCameraLens(long outPtr); // writes 16 floats

  // ---- markers ----
  long addMarker(DOMString pattName);
  long addPatternFromBuffer(long pattPtr, long pattLen); // TODO in C++: implement via MEMFS or memory loader
  void setMatrixCodeType(long type);

  // ---- config ----
  void setThreshold(long threshold);
  long getThreshold();
  void setThresholdMode(long mode);
  long getThresholdMode();
  void setDebugMode(long enable);
  long getDebugMode();
  void setImageProcMode(long mode);
  long getImageProcMode();
  void setProjectionNearPlane(float nearPlane);
  float getProjectionNearPlane();
  void setProjectionFarPlane(float farPlane);
  float getProjectionFarPlane();

  // ---- buffers ----
  long getFrameBufferRGBA();
  long getFrameBufferGRAY();
  long getFrameWidth();
  long getFrameHeight();
  long setFrameRGBA(long dataPtr, long dataLen);
  long setFrameGRAY(long dataPtr, long dataLen);

  // ---- detect ----
  // 0=RGBA8, 1=GRAY8
  long detectMarker();

  // ---- results ----
  long getMarkerCount();

  // MarkerSummary via out-buffer would be ideal, but WebIDL binder doesn't do structs well.
  // We expose primitive getters.
  //long getMarkerKind(long index);
  //long getMarkerId(long index);
  //float getMarkerConfidence(long index);
  long getMarkerPose44(long index, long outPtr); // writes 16 floats
};