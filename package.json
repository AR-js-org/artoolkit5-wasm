{
  "name": "@kalwalt/artoolkit5-wasm",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./loader": {
      "types": "./dist/loader.d.ts",
      "import": "./dist/loader.js"
    }
  },
  "files": [
    "dist/index.js",
    "dist/index.js.map",
    "dist/index.d.ts",
    "dist/index.d.ts.map",
    "dist/artoolkit5.js",
    "dist/artoolkit5.wasm",
    "dist/loader.d.ts",
    "dist/loader.d.ts.map"
  ],
  "scripts": {
    "build:wasm": "node scripts/build-wasm-docker.mjs",
    "build:wrap": "vite build && tsc -p tsconfig.build.json",
    "build": "npm run build:wasm && npm run build:wrap",
    "lint:cpp": "node scripts/clang-format.mjs --lint",
    "format:cpp": "node scripts/clang-format.mjs"
  },
  "dependencies": {
    "artoolkit5-constants": "git+https://github.com/AR-js-org/artoolkit5-constants.git#f10fe01cddc0fcbf90af02a1477d03364a3c4125"
  },
  "devDependencies": {
    "clang-format": "^1.8.0",
    "glob": "^13.0.6",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  }
}
