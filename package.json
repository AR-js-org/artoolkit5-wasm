{
  "name": "@ar-js-org/artoolkit5-wasm",
  "version": "0.1.2",
  "description": "A high-performance WebAssembly port of WebARKitLib (ARToolKit5) for marker tracking, pose estimation, and marker generation in the browser and Node.js.",
  "keywords": [
    "artoolkit",
    "artoolkit5",
    "wasm",
    "webassembly",
    "webarkitlib",
    "ar",
    "augmented-reality",
    "marker-tracking",
    "pose-estimation",
    "ar-js"
  ],
  "author": "Walter Perdan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ar-js-org/artoolkit5-wasm.git"
  },
  "homepage": "https://github.com/ar-js-org/artoolkit5-wasm#readme",
  "bugs": {
    "url": "https://github.com/ar-js-org/artoolkit5-wasm/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./loader": {
      "types": "./dist/loader.d.ts",
      "import": "./dist/loader.js"
    }
  },
  "files": [
    "dist/index.js",
    "dist/index.js.map",
    "dist/index.d.ts",
    "dist/index.d.ts.map",
    "dist/artoolkit5.js",
    "dist/artoolkit5.wasm",
    "dist/loader.d.ts",
    "dist/loader.d.ts.map"
  ],
  "scripts": {
    "clean": "node -e \"const fs=require('fs');['dist/index.js','dist/index.js.map','dist/index.d.ts','dist/index.d.ts.map','dist/loader.d.ts','dist/loader.d.ts.map','dist/src'].forEach(p=>{try{fs.rmSync(p,{recursive:true,force:true})}catch{}})\"",
    "build:wasm": "node scripts/build-wasm-docker.mjs",
    "build:wrap": "npm run clean && vite build && tsc -p tsconfig.build.json",
    "build": "npm run build:wasm && npm run build:wrap",
    "lint:cpp": "node scripts/clang-format.mjs --lint",
    "format:cpp": "node scripts/clang-format.mjs"
  },
  "dependencies": {
    "@ar-js-org/artoolkit5-constants": "^0.2.0"
  },
  "devDependencies": {
    "clang-format": "^1.8.0",
    "glob": "^13.0.6",
    "typescript": "^7.0.2",
    "vite": "8.0.16"
  }
}
