{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationMap": true,
    "rootDir": "src",
    "outDir": "dist",
    "stripInternal": true,
    "isolatedModules": false
  },
  "include": ["src/**/*"],
  "exclude": ["dist", "build", "node_modules"]
}